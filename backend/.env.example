DEV_PORT=3056

# The frontend's URL — the only origin allowed to call the API cross-origin.
# In production, your Render frontend URL.
FRONTEND_URL=http://localhost:5174

# IP the fake suspicious login comes from (looked up to a city for the demo).
SIMULATED_LOGIN_IP=185.220.101.1

# Institution name Big Fish uses, including the support team it escalates to.
BANK_NAME=Northwind Bank

# Powers the Big Fish support chat. Leave blank to use scripted fallback replies.
ANTHROPIC_API_KEY=

# Bluetooth proximity check: the secret your DoubleCheck Key serves. Generate one with
#   node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
# and put the same value in the companion app (or nRF Connect / LightBlue).
AUTH_DEVICE_KEY=
