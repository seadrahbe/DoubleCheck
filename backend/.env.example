DEV_PORT=3056

# Where the survey link in the text points. Must be reachable from your phone:
# your computer's LAN IP (e.g. http://192.168.1.20:5173) or an ngrok URL.
FRONTEND_URL=http://localhost:5174

# IP the fake suspicious login comes from (looked up to a city for the text).
SIMULATED_LOGIN_IP=185.220.101.1

# Twilio (https://console.twilio.com). Leave blank to just log texts to the console.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+15555550100

# Email via Resend (https://resend.com): sign up, then API Keys -> Create.
# Leave blank to just log emails to the console. With the default sender
# (onboarding@resend.dev) Resend only delivers to your own Resend account's email,
# so set MY_EMAIL to that. Verify a domain in Resend to send from/to anything else.
RESEND_API_KEY=
EMAIL_FROM="DoubleCheck <onboarding@resend.dev>"

# Where messages go. Texts/emails are only ever sent to these.
MY_PHONE_NUMBER=+15555550123
MY_EMAIL=you@example.com
