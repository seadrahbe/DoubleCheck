DEV_PORT=3056

# Where the survey link points. Must be reachable from your phone if you open it
# there: your computer's LAN IP (e.g. http://192.168.1.20:5173) or an ngrok URL.
FRONTEND_URL=http://localhost:5174

# IP the fake suspicious login comes from (looked up to a city for the demo).
SIMULATED_LOGIN_IP=185.220.101.1

# Email via Resend (https://resend.com): sign up, then API Keys -> Create.
# Leave blank to just log emails to the console. With the default sender
# (onboarding@resend.dev) Resend only delivers to your own Resend account's email,
# so set MY_EMAIL to that. Verify a domain in Resend to send from/to anything else.
RESEND_API_KEY=
EMAIL_FROM="DoubleCheck <onboarding@resend.dev>"

# Powers the Big Fish support chat. Leave blank to use scripted fallback replies.
ANTHROPIC_API_KEY=

# Bluetooth proximity check: the secret your DoubleCheck Key serves. Generate one with
#   node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
# and put the same value in the companion app (or nRF Connect / LightBlue).
AUTH_DEVICE_KEY=

# Where email goes. (Text messages are no longer sent; the on-screen phone shows them.)
MY_PHONE_NUMBER=+15555550123
MY_EMAIL=you@example.com
